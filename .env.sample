DB_HOST=darts_score_mongo
DB_USER=admin
DB_PASSWORD=12345678
DB_NAME=darts_score
DB_PORT=27017

UI_URL=http://darts_score_ui:3000

IMG_DIR=data/img

NODE_ENV=development

# Signs the login cookie. Use a long random value; changing it logs everybody out.
SESSION_SECRET=change-me-to-a-long-random-string

# First global admin, created on startup when no global admin exists yet.
# Existing players and games are moved into a "Default Club" owned by this account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# Email (password reset and club admin invitations). Without SMTP_HOST these features are off.
# APP_URL is the public address of the app, used for the links in mails.
APP_URL=http://localhost:3001
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Darts Score <no-reply@example.com>
