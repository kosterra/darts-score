# Settings of Darts Score. Copy to ".env" and fill in.
# Used by docker-compose.yml (production) and docker-compose.dev.yml (development,
# which sets the database host, Mailpit and NODE_ENV for you). For running the API
# without Docker, copy it to app-api/.env and set DB_HOST=localhost.

# --- Database (the same user and password as in mongo.env) ------------------
DB_HOST=darts_score_mongo
DB_PORT=27017
DB_NAME=darts_score
DB_USER=admin
DB_PASSWORD=change-me-to-a-long-random-password

# --- Login --------------------------------------------------------------------
# Signs the login cookie. Use a long random value (e.g. "openssl rand -hex 32");
# without it every restart logs everybody out.
SESSION_SECRET=change-me-to-a-long-random-string
# The first global admin, created on the first start when there is none yet.
# Changing these later does not touch the existing account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-8-characters

# --- Address ------------------------------------------------------------------
# The public address of the app, used for the links in mails.
APP_URL=https://darts.example.com

# --- Mail (password reset and invitations) -----------------------------------
# Without SMTP_HOST, mails are switched off: admins then set initial passwords
# for new accounts themselves.
SMTP_HOST=smtp.example.com
# 587 = STARTTLS (most providers), 465 = TLS from the start
SMTP_PORT=587
# SMTP_SECURE=true        # only needed for TLS on a port other than 465
SMTP_USER=darts@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=Darts Score <darts@example.com>

# --- Optional -----------------------------------------------------------------
# "production" (default): unexpected errors answer only "Internal server error."
# Anything else, e.g. "test" on a test server, sends the error details and is
# shown as the environment on the administration page.
# For local development without Docker use NODE_ENV=development.
# NODE_ENV=production
# Only when the UI runs on its own address (local development without Docker):
# the address the browser uses for it, allowed to call the API
# UI_URL=http://localhost:3000
# Where uploaded pictures are stored inside the container (mounted as ./data)
IMG_DIR=data/img
# error, warn, info or debug; "debug" logs every request, handy on a test server
LOG_LEVEL=info
