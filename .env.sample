# Settings of Darts Score. Copy to ".env" next to docker-compose.yml and fill in,
# or enter them as the stack's environment variables in Portainer.
# docker-compose.dev.yml reads it too (it sets the database host, Mailpit and
# NODE_ENV itself). For running the API without Docker, copy it to app-api/.env
# and set DB_HOST=localhost.

# --- Database -------------------------------------------------------------------
# With docker-compose.yml the database is created with exactly this user and
# password on its first start. "mongo" is the database's service name there.
DB_HOST=mongo
DB_PORT=27017
DB_NAME=darts_score
DB_USER=admin
DB_PASSWORD=change-me-to-a-long-random-password

# --- Login --------------------------------------------------------------------
# Signs the login cookie. Use a long random value (e.g. "openssl rand -hex 32");
# without it every restart logs everybody out.
SESSION_SECRET=change-me-to-a-long-random-string
# Encrypts the secrets of two-step login (changing it turns two-step login off for everyone)
MFA_KEY=change-me-to-another-long-random-string
# The first global admin, created on the first start when there is none yet.
# Changing these later does not touch the existing account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-at-least-8-characters

# --- Address ------------------------------------------------------------------
# The public address of the app, used for the links in mails.
APP_URL=https://darts.example.com

# --- Public access through a Cloudflare Tunnel (optional) ---------------------
# Starts the tunnel of docker-compose.yml. Its token comes from the Cloudflare
# dashboard (Zero Trust → Networks → Tunnels); give the tunnel a public hostname
# (the one in APP_URL) with the service http://darts_score:3001.
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=

# --- Mail (password reset and invitations) -----------------------------------
# Without SMTP_HOST, mails are switched off: admins then set initial passwords
# for new accounts themselves.
SMTP_HOST=smtp.example.com
# 587 = STARTTLS (most providers), 465 = TLS from the start
SMTP_PORT=587
# SMTP_SECURE=true        # only needed for TLS on a port other than 465
SMTP_USER=darts@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=Legmate <darts@example.com>

# --- Optional -----------------------------------------------------------------
# "production" (default): unexpected errors answer only "Internal server error."
# Anything else, e.g. "test" on a test server, sends the error details and is
# shown as the environment on the administration page.
# For local development without Docker use NODE_ENV=development.
# NODE_ENV=production
# Only when the UI runs on its own address (local development without Docker):
# the address the browser uses for it, allowed to call the API
# UI_URL=http://localhost:3000
# Where uploaded pictures are stored inside the container (mounted as ./data)
IMG_DIR=data/img
# error, warn, info or debug; "debug" logs every request, handy on a test server
LOG_LEVEL=info
# A test installation: e.g. TEST, in front of the subject and on a yellow strip on
# top of every mail it sends. Leave it empty for the real installation.
ENVIRONMENT_LABEL=
