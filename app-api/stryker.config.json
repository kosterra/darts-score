{
    "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
    "packageManager": "npm",
    "testRunner": "vitest",
    "vitest": {
        "configFile": "vitest.config.js"
    },
    "coverageAnalysis": "perTest",
    "reporters": [
        "clear-text",
        "html",
        "json",
        "progress-append-only"
    ],
    "htmlReporter": {
        "fileName": "reports/mutation/mutation.html"
    },
    "jsonReporter": {
        "fileName": "reports/mutation/mutation.json"
    },
    "thresholds": {
        "high": 80,
        "low": 60,
        "break": null
    },
    "mutate": [
        "src/utils/integrity.js",
        "src/utils/tournaments.js",
        "src/utils/game.utils.js",
        "src/utils/auth.utils.js",
        "src/utils/kpi.data.js",
        "!src/**/*.test.js"
    ],
    "ignorePatterns": [
        "node_modules",
        "dist",
        "test/data",
        "reports"
    ],
    "tempDirName": ".stryker-tmp",
    "cleanTempDir": true,
    "concurrency": 2,
    "timeoutMS": 30000,
    "timeoutFactor": 2,
    "ignoreStatic": true
}
