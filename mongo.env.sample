# Only for development with docker-compose.dev.yml: the MongoDB administrator,
# created on the database's first start. Copy to "mongo.env"; user and password
# must match DB_USER and DB_PASSWORD in .env.
# (docker-compose.yml for production takes them from DB_USER and DB_PASSWORD.)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me-to-a-long-random-password
MONGO_INITDB_DATABASE=darts_score
